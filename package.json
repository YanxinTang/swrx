{
  "name": "@tyx1703/swrx",
  "version": "1.0.0",
  "description": "fetcher 即 key，类型安全的 SWR hooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YanxinTang/swrx.git"
  },
  "homepage": "https://yanxintang.github.io/swrx/",
  "bugs": {
    "url": "https://github.com/YanxinTang/swrx/issues"
  },
  "keywords": [
    "swr",
    "react",
    "hooks",
    "typescript",
    "data-fetching",
    "fetcher"
  ],
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "format": "prettier --write .",
    "lint": "rslint",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "bumpp": "bumpp --recursive"
  },
  "devDependencies": {
    "@rslib/core": "^1.0.3",
    "@rslint/core": "^0.9.0",
    "@rstest/adapter-rslib": "^0.12.2",
    "@rstest/core": "^0.12.2",
    "@types/node": "^24.19.0",
    "bumpp": "^12.3.0",
    "prettier": "^3.9.6",
    "swr": "^2.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "swr": "^2.0.0"
  }
}
